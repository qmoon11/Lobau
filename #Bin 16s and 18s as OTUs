#Bin ITS and 18s as OTUs
#activate vsearch
conda activate vsearch_env


#bin ITS at 98%
vsearch --cluster_fast DADA2_ASVs_combined_ITS.fna --id 0.98 --strand plus \
  --centroids OTU98_centroids.fna --uc OTU98_map.uc --relabel OTU98_ --threads 8

